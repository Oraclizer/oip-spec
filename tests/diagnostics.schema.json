{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact artifact-bound compiler diagnostics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_sha256",
    "driver_sha256",
    "allowed"
  ],
  "properties": {
    "schema": {
      "const": "oip-compiler-diagnostics-v1"
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "driver_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "allowed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stream",
          "lines",
          "maximum"
        ],
        "properties": {
          "stream": {
            "enum": [
              "stdout",
              "stderr"
            ]
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[^\\r\\n]*$"
            }
          },
          "maximum": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      }
    }
  }
}
